PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# Supabase transaction pooler (port 6543, ?pgbouncer=true) - runtime connections
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase session pooler / direct (port 5432) - migrations only
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-eu-west-3.pooler.supabase.com:5432/postgres"
SUPABASE_URL=https://<ref>.supabase.co
# Legacy JWT secret only (projects with asymmetric signing keys leave blank)
SUPABASE_JWT_SECRET=
# Server-side only. Enables invitation emails from Settings > People. Never commit the real key.
SUPABASE_SERVICE_ROLE_KEY=
TRUST_PROXY=0
RATE_LIMIT_PER_MINUTE=300
DB_POOL_MAX=10
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=change-me-locally
SEED_DEMO_GOODS=true
